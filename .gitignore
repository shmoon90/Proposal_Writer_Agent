# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Secrets / local config
.env
.env.*
!.env.example
*.key

# Business deliverables (generated per project; kept out of source control)
Output/*
!Output/.gitkeep

# Temporary working files
workspace/*
!workspace/.gitkeep

# Local DB
*.sqlite3
*.db
data/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml

# Customer sample materials (RFP, proposals, requirement specs, trace matrices, WBS, staffing plans)
# are confidential and must never be committed. Keep them outside the repository (separate drive/folder).
samples/
samples_private/
*.local
.sensitive-terms.local

# 진행 상태 기록은 버전 관리 (workspace의 DB·로그는 제외 유지)
!workspace/DEVELOPMENT_STATUS.md
!workspace/DEVELOPMENT_STATUS.json
