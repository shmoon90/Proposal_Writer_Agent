# Claude API 키 (에이전트 실행 시 필수). 로그·DB에 기록되지 않는다.
ANTHROPIC_API_KEY=

# 선택 설정 (접두사 PWA_). 비워 두면 기본값.
# PWA_MODEL_PRIMARY=claude-opus-5-5
# PWA_MODEL_WORKER=claude-sonnet-5-5
# PWA_MAX_BUDGET_USD_PER_STEP=2.0
# PWA_MAX_TURNS_DEFAULT=30
# PWA_OUTPUT_ROOT=C:\dev\Claude_Work\Proposal_Writer_Agent\Output
# PWA_WORKSPACE_ROOT=C:\dev\Claude_Work\Proposal_Writer_Agent\workspace
# PWA_DB_PATH=C:\dev\Claude_Work\Proposal_Writer_Agent\workspace\pwa.sqlite3
# PWA_APPROVER_NAME=user
# PWA_LOG_LEVEL=INFO

# 실행 환경: dev(기본) / prod. prod에서는 API 키가 없으면 기동 시 ConfigError.
# PWA_APP_ENV=dev
